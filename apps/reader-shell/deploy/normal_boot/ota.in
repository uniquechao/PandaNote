#!/bin/sh
# OTA 执行者独立于普通应用及其进程组。
normal_ota_init(){
    NORMAL_OTA_WORKER="$release/ota/ota-worker.mipsel"
    [ -f /user/pandanote/config/ota.json ] || return 0
    normal_spawn ota /bin/busybox env -i PATH="$PATH" HOME=/user/pandanote TMPDIR=/tmp LD_LIBRARY_PATH=/run/pandanote-opt/opt/image/opt/Qtopia/lib:/lib:/usr/lib "$NORMAL_OTA_WORKER" || return 0
}
normal_ota_reboot(){
    [ -n "${DEV_PID_ota-}" ] || return 0
    [ -e "$DEV_RUN/ota/reboot.request" ] || return 0
    normal_private_file "$DEV_RUN/ota/reboot.request" || return 0
    normal_child_running ota || return 0
    # 原生代码复核 worker 身份、提交状态、新版闭包及只读根，
    # 并持久化独占消费标记，保证每次事务最多请求一次重启。
    /bin/busybox env -i PATH="$PATH" LD_LIBRARY_PATH=/run/pandanote-opt/opt/image/opt/Qtopia/lib:/lib:/usr/lib "$NORMAL_OTA_WORKER" --reboot-check || return 0
    bb sync && bb reboot
}
