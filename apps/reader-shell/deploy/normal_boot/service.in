#!/bin/sh
# BusyBox init owns this foreground service. Runtime failure stays in USB rescue.
bb(){ /bin/busybox "$@"; }
normal_rescue(){
    local reason="$1"
    # Stop and reap only the app session this service owns; retain adbd rescue.
    if [ -n "${DEV_PID_app-}" ]; then normal_stop app || reason=app-stop-failed; fi
    bb printf '%s\n' "$reason" > /run/pandanote-normal/rescue.reason
    while :; do if [ -n "${NORMAL_OTA_WORKER-}" ]; then normal_ota_reboot;fi;bb sleep 2; done
}
normal_usb(){
    local value gadget=/sys/kernel/config/usb_gadget/adb_demo
    value=$(bb sha256sum /usr/bin/adbd) || return 1
    [ "${value%% *}" = f819818a78b04a6aa90970231d050cd037b0650e595de8b3aa42b7687cab17d5 ] || return 1
    bb mount -t configfs -o nosuid,nodev,noexec configfs /sys/kernel/config || return 1
    bb mkdir "$gadget" || return 1
    bb mkdir -p "$gadget/strings/0x409" "$gadget/configs/c.1/strings/0x409" "$gadget/functions/ffs.adb" || return 1
    bb printf '%s\n' 0x18d1 > "$gadget/idVendor" || return 1
    bb printf '%s\n' 0xd004 > "$gadget/idProduct" || return 1
    bb printf '%s\n' 0x0200 > "$gadget/bcdUSB" || return 1
    bb printf '%s\n' 0x0100 > "$gadget/bcdDevice" || return 1
    bb printf '%s\n' PandaNote > "$gadget/strings/0x409/manufacturer" || return 1
    bb printf '%s\n' PandaNote > "$gadget/strings/0x409/product" || return 1
    bb printf '%s\n' PANDANOTE966U2_NORMAL > "$gadget/strings/0x409/serialnumber" || return 1
    bb printf '%s\n' 120 > "$gadget/configs/c.1/MaxPower" || return 1
    bb printf '%s\n' adb > "$gadget/configs/c.1/strings/0x409/configuration" || return 1
    bb ln -s "$gadget/functions/ffs.adb" "$gadget/configs/c.1/ffs.adb" || return 1
    bb mkdir -p /dev/usb-ffs/adb || return 1
    bb mount -t functionfs -o nosuid,nodev,noexec adb /dev/usb-ffs/adb || return 1
    normal_spawn adbd /bin/busybox env -i PATH="$PATH" HOME=/tmp TMPDIR=/tmp EXTERNAL_STORAGE=/tmp /usr/bin/adbd
}
normal_poweroff(){
    normal_private_file "$DEV_RUN/poweroff.request" || return 1
    [ "$(bb cat "$DEV_RUN/poweroff.request")" = poweroff-v1 ] || return 1
    normal_stop app || return 1
    normal_log application-stopped || return 1
    bb sync || return 1
    # Normal BusyBox poweroff asks PID1; never force or bypass shutdown actions.
    bb poweroff || return 1
}
normal_release(){
    # current is an ordinary management pointer. This boot entry accepts only its
    # reviewed release; interrupted preparation of a future current falls back
    # to this entry's own pinned release until inittab is atomically committed.
    release_id=@NATIVE_SHA@
    if normal_private_file /user/pandanote/apps/current; then
        current=$(bb cat /user/pandanote/apps/current)
        [ "$current" != "$release_id" ] || release_id=$current
    fi
    release=/user/pandanote/apps/releases/$release_id
    [ -d "$release" ] && [ ! -L "$release" ] || return 1
    [ "$(bb readlink -f "$release")" = "$release" ] || return 1
    local value
    value=$(bb sha256sum "$release/manifest.json") || return 1
    [ "${value%% *}" = "$release_id" ] || return 1
    value=$(bb sha256sum "$release/release.sha256") || return 1
    [ "${value%% *}" = @RELEASE_INDEX_SHA@ ] || return 1
    (cd "$release" && bb sha256sum -c release.sha256) >/dev/null 2>&1
}
main(){
    [ "$#" = 0 ] && [ "$PPID" = 1 ] || exit 1
    umask 077
    PATH=/sbin:/bin:/usr/sbin:/usr/bin;export PATH
    unset LD_PRELOAD LD_LIBRARY_PATH ENV BASH_ENV
    [ "$(bb cat /run/pandanote-normal/early.ready)" = @BOOT_ID@ ] || normal_rescue early-failed
    (cd @SYSTEM@ && bb sha256sum -c SHA256SUMS) >/dev/null 2>&1 || normal_rescue system-pin-failed
    . @SYSTEM@/policy.sh
    N_PROC=/proc;N_SYS=/sys;N_DEV=/dev
    DEV_RUN=/run/pandanote-normal;DEV_BB=/bin/busybox
    DEV_SUPERVISOR=@SYSTEM@/child-supervisor.sh;DEV_SUPERVISOR_SHA=@SUPERVISOR_SHA@
    normal_usb || normal_rescue usb-failed
    # USB comes first so failed storage/hardware remains diagnosable.
    normal_mount_persistent || normal_rescue storage-failed
    bb printf '%s\n' normal-persistent-v1 > "$DEV_RUN/storage.ready"
    normal_release || normal_rescue release-pin-failed
    . @SYSTEM@/ota.sh
    normal_ota_init || :
    . @SYSTEM@/hardware.sh
    normal_hardware || normal_rescue hardware-failed
    /bin/busybox sh "$release/radio/radio-normal-init.sh" --wifi-normal || normal_rescue radio-failed
    bb mkdir -m 0700 /run/pandanote-normal/empty-plugins || normal_rescue runtime-path-failed
    bb printf '%s\n' '4498 18 -817313 -41 2747 -763357 35540' > /run/pandanote-normal/pointercal
    bb printf '%s\n' power-keys-v1 > "$DEV_RUN/power.ready" || normal_rescue power-setup-failed
    normal_spawn app /bin/busybox env -i PATH="$PATH" HOME=/user/pandanote TMPDIR=/tmp XDG_CONFIG_HOME=/user/pandanote/config XDG_CACHE_HOME=/user/pandanote/cache QTDIR="$release" QT_QWS_FONTDIR="$release/assets" QT_PLUGIN_PATH=/run/pandanote-normal/empty-plugins POINTERCAL_FILE=/run/pandanote-normal/pointercal LD_LIBRARY_PATH=/run/pandanote-opt/opt/image/opt/Qtopia/lib:/lib:/usr/lib QWS_DISPLAY=Transformed:Rot270:LinuxFb:mmWidth200:mmHeight120:0 QWS_KEYBOARD=none QWS_MOUSE_PROTO=evdevtouch:/dev/input/event0 QWS_NO_SHARE_FONTS=1 "$release/reader-shell.mipsel" --qws-server --power-keys --workspace-dir /user/pandanote --sync-config /user/pandanote/config/reader-sync.ini --sync-cache-dir /user/pandanote/cache/sync --bluetooth-ipc /tmp/pandanote-connectivity/bluetooth/service/local.sock || normal_rescue app-launch-failed
    trap 'normal_stop ota || :;normal_stop app || :;normal_stop adbd || :;bb sync;exit 0' TERM INT
    . @SYSTEM@/suspend.sh
    normal_suspend_init || : # Missing suspend capability leaves ordinary UI/USB operational.
    normal_log application-started || :
    while :; do
        bb sleep 2
        normal_ota_reboot
        normal_ota_supervise
        if [ -e "$DEV_RUN/poweroff.request" ] || [ -L "$DEV_RUN/poweroff.request" ]; then
            normal_poweroff || normal_rescue poweroff-failed
            while :; do bb sleep 3600; done
        fi
        if ! normal_child_running app; then normal_stop app || :;normal_log application-failed || :;normal_rescue app-exited;fi
        normal_child_running adbd || normal_rescue adbd-exited
        normal_runtime_ok || normal_rescue runtime-context-failed
        normal_suspend_cycle
    done
}
main "$@"
